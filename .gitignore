# ============================================================
# .gitignore — honda-civic-g10-skip-disclaimer
# ============================================================
# Esse projeto deliberadamente NÃO distribui firmware proprietário,
# binários de terceiros nem dumps obtidos do veículo. Essas pastas
# são excluídas aqui. Para rodar o projeto você precisa dumpar
# do próprio HU — ver docs/pt-BR/03-descobrindo-sua-safra.md.
# ============================================================

# ---- Material proprietário Honda/Mitsubishi (NUNCA commitar) ----
# Dumps de /system obtidos do HU — contém APKs proprietários
tooling/apks-dumped/
# APKs e smali decompilados de apps proprietários do HU
tooling/apks-decoded/

# ---- Repos de terceiros clonados pelo setup.sh ----
# Estes têm licenças próprias (ic1101 Apache 2.0, root-honda sem
# license clara, 2016PilotOneClick GPL). setup.sh clona do upstream.
tooling/references/

# ---- Ferramentas baixadas pelo setup.sh ----
# apktool + jadx são baixados em runtime, não distribuídos aqui
tooling/bin/apktool
tooling/bin/apktool.jar
tooling/bin/jadx/

# ---- Binários pre-built de terceiros (precisam ser extraídos localmente) ----
# busybox: vem do HondaHack.apk (binário proprietário de distribuição)
# su: vem do root-honda (origem dubia da license)
# sleep: vem do ic1101 (Apache 2.0, OK em teoria mas deixa setup.sh baixar)
tooling/ota-build/bin/busybox
tooling/ota-build/bin/su
tooling/ota-build/bin/sleep

# ---- Builds (saídas efêmeras, reconstruíveis) ----
tooling/ota-build/output/
tooling/ota-build/output-rollback/

# ---- Overlay do pacote OTA ----
# AutoOk.apk no overlay é rebuildável via `./gradlew assembleRelease`.
# Opcionalmente ignorar para não distribuir APK assinado — leitor rebuilda.
tooling/ota-build/overlay/system/app/AutoOk.apk

# ---- APK compilado ----
# Rebuild via our-apk/ -> gradlew assembleRelease + apksigner.
our-apk/app/build/
our-apk/build/
our-apk/.gradle/
our-apk/local.properties

# ---- IDE / OS ----
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# ---- Python ----
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ---- Scratchpad / temp ----
*.swp
*.bak
*~

# ---- Artefatos de deploy específicos deste veículo ----
# Logs/dumps gerados em deploys reais na central do dono do projeto.
# Não distribuir — podem conter dados identificadores da central.
docs/fase7-deploy-2026-10-16/artefatos-deploy/
